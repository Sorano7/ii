~~ Basic ~~
ii:: ii
fcomp:: f;g;x; f.g(x)
flip:: f;x;y; f.y.x

~~ Logic ~~
and:: a;b; a.b.false
or:: a;b; a.true.b
not:: a; a.false.true
xor:: a;b; a.not(b).b

if:: pair
ite:: f;a;b; f.a.b

~~ Pair ~~
pair:: a;b;f; f.a.b
fst:: p; p.true
snd:: p; p.false
swap:: p; pair (snt.p) (fst.p)
curry:: f;a;b; f.[a, b]
uncurry:: f;p; f (fst.p) (snd.p)
showPair:: p; "[" + string(fst.p) + ", " + string(snd.p) + "]" >> print

~~ List ~~
isNil:: x; x = nil
null:: isNil
nullThen:: x;y; null(y).x.y

cons:: pair
head:: fst
tail:: snd

foldr:: f;z;xs; null(xs) .z .(f.head(xs) <> foldr.f.z.tail(xs))
foldl:: f;z;xs; null(xs) .z <> foldl.f.(f.z.head(xs)).tail(xs)
map:: f;xs; foldr .(fcomp.cons.f) .nil .xs
filter:: f;xs; foldr .(_filter.f) .nil .xs
_filter:: f;x;xs; f.x .(cons.x.xs) .xs
len:: xs; map.[a; 1].xs >> foldr.add.0  
index:: x;xs; _index.x.xs.0
_index:: x;xs;z; or .null(xs) .(x=head(xs)) ?? z !! _index.x.tail(xs).(z+1)
at:: n;xs; _at.n.xs.0
_at:: n;xs;z; or .null(xs) .(z=n) ?? head(xs) !! _at.n.tail(xs).(z+1)
append:: xs;y; foldr .cons .(cons.y.nil) .xs
concat:: xs;ys; foldr .cons .ys .xs
reverse:: xs; foldl.(flip.cons).nil.xs
seq:: l;h; (l>=h) ?? cons.l.nil !! cons.l.seq(l+1)(h)
join:: z;xs; foldr.[a;b; null(b) ?? a+b !! a+z+b]."".xs
showList:: xs; map.string.xs >> join.", " >> [x; "{ "+ x + " }"] >> print

asPair:: xs; pair .(head.xs) .head(tail.xs)

~~ String ~~
isSpace:: x; x=' '
showString:: xs; join."".xs >> print

~~ Arithmetic ~~
pred:: a; a - 1
succ:: a; a + 1
add:: a;b; a + b
sub:: a;b; a - b
mul:: a;b; a * b
div:: a;b; a / b

sum:: xs; foldr .add .0 .xs
fac:: n; (n=0) ?? 1 !! n * fac(n-1)
fib:: n; (n=0) ?? 0 !! (n=1) ?? 1 !! (fib(n-1) + fib(n-2))

isOdd:: n; n % 2 = 1
isEven:: n; n % 2 = 0

isNumber:: n; number.n != nil